{
  "name": "kingdom-clone",
  "private": true,
  "version": "0.1.0",
  "description": "Браузерная 2D-микростратегия по мотивам Kingdom Two Crowns: монарх, монеты, жители и ночные атаки Жадности.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "build:artifact": "vite build && node scripts/artifact.mjs",
    "build:itch": "vite build && node scripts/itch.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
